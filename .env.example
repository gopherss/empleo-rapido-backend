# Entorno
NODE_ENV=development
PORT=3000

# Base de datos PostgreSQL
DATABASE_URL="postgresql://postgres:password@localhost:5432/empleo_rapido?schema=public"

# JWT
JWT_ACCESS_SECRET="cambia-este-secreto-de-acceso"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="cambia-este-secreto-de-refresh"
JWT_REFRESH_EXPIRES_IN="30d"

# CORS (origenes separados por coma)
CORS_ORIGINS="http://localhost:5173"

# Archivos subidos
UPLOAD_DIR="uploads"
PUBLIC_BASE_URL="http://localhost:3000"
